# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید.

# --- وب سرور ---
HOST=127.0.0.1
PORT=8000
# DATA_DIR=./data
MAX_UPLOAD_MB=100
# ورود ساده برای سرور عمومی (مرورگر فرم ورود نشان می‌دهد). خالی = بدون ورود
APP_USERNAME=admin
APP_PASSWORD=

# --- پایگاه داده برداری پیش‌فرض برای پایگاه‌های دانش جدید ---
# chroma: لوکال (پوشه data/chroma)  |  qdrant: سرور
VECTOR_STORE=chroma
# CHROMA_HOST=localhost        # اگر Chroma را به‌صورت سرور اجرا می‌کنید
# CHROMA_PORT=8000
# QDRANT_URL=http://localhost:6333   # خالی = Qdrant embedded در data/qdrant (فقط توسعه)
# QDRANT_API_KEY=

# --- OpenAI (یا هر سرویس سازگار با OpenAI) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (لوکال) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- HuggingFace لوکال ---
HF_DEVICE=cpu
# روی سرورهای ابری با IP مشترک (مثل RunPod)، HuggingFace ممکن است خطای 429 بدهد؛ توکن رایگان از huggingface.co/settings/tokens
HF_TOKEN=
# true = مدل‌ها فقط از کش محلی بارگذاری شوند (برای سروری که به HuggingFace دسترسی ندارد)
HF_HUB_OFFLINE=false
# --- مرحله پس از بازیابی (در پنل روشن/خاموش می‌شوند) ---
# Rerank با cross-encoder لوکال؛ سبک: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1، دقیق‌تر: BAAI/bge-reranker-v2-m3
RERANKER_MODEL=
# Rerank با LLM؛ خالی = همان مدل پیش‌فرض گفتگو
RERANK_LLM_PROVIDER=
RERANK_LLM_MODEL=
# Jev (TypeSafe AI): فیلتر ارتباط و بررسی پاسخ‌پذیری
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# با کلید OpenRouter:  JEV_BASE_URL=https://openrouter.ai/api  و  JEV_MODEL=typesafe/jev-1.14
JEV_THRESHOLD=0.35
JEV_ANSWERABLE_THRESHOLD=0.5

# --- مدل‌های پیش‌فرض در پنل ---
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# --- OCR (اختیاری) ---
OCR_LANG=fas
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
